{
  "name": "bookleaf-author-support-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Author Support & Communication Portal with AI-assisted triage and drafting",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reset-db": "node -e \"require('fs').rmSync(process.env.DB_PATH||'./data/bookleaf.db',{force:true})\" && node src/db/seed-cli.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.0"
  }
}
