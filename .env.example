
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
DB_PATH=./data/bookleaf.db

# --- AI (server-side only; never sent to the browser) ---
ANTHROPIC_API_KEY=                 # leave empty to run in rules-only fallback mode
AI_MODEL=claude-haiku-5-5          # any Anthropic model id; Haiku-class recommended
AI_TIMEOUT_MS=15000
AI_ENABLED=true


DEMO_AUTHOR_PASSWORD=Author@123
DEMO_ADMIN_PASSWORD=Admin@123
